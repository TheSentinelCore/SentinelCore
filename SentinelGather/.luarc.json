{
    "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "Lua 5.1",
        "path": [
            "?.lua",
            "?/init.lua"
        ]
    },
    "workspace": {
        "library": [
            "../.api",
            "../common"
        ],
        "ignoreDir": [
            "documentation"
        ]
    },
    "diagnostics": {
        "globals": [
            "core",
            "color",
            "vec2",
            "vec3",
            "enums"
        ],
        "disable": [
            "lowercase-global",
            "inject-field",
            "undefined-field",
            "param-type-mismatch",
            "assign-type-mismatch",
            "need-check-nil"
        ]
    }
}
